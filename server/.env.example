# ---------------------------------------------------------------------------
# PromoCode Manager — backend environment variables.
# Every variable has a built-in default; this file documents them all.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Timezone applied to the Node process (all timestamps are stored in UTC).
TZ=UTC
# error | warn | log | debug | verbose — levels are cumulative (warn => error+warn).
# `warn` keeps a healthy start completely silent.
LOG_LEVEL=warn
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# MongoDB — source of truth
MONGO_URI=mongodb://localhost:27017/promocodes

# ClickHouse — analytical read model
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=promocodes
CLICKHOUSE_REQUEST_TIMEOUT_MS=10000

# Redis — refresh tokens, promo apply locks, analytics cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# Accepts 900, 30s, 15m, 12h, 7d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# Promo apply distributed lock (Redis SET NX PX on lock:promocode:{CODE})
PROMO_LOCK_TTL_MS=10000
PROMO_LOCK_WAIT_MS=5000
PROMO_LOCK_RETRY_DELAY_MS=50

# Analytics list cache (Redis). ClickHouse is probed before every cached answer,
# so a ClickHouse outage returns 503 even when the cache is warm.
ANALYTICS_CACHE_TTL_SECONDS=5

# Outbox worker (Mongo -> ClickHouse replication)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=500
OUTBOX_MAX_ATTEMPTS=20

# Demo seed (idempotent, runs on every start)
SEED_ENABLED=true
SEED_DEMO_PHONE=+79991234567
SEED_DEMO_PASSWORD=Demo1234!
